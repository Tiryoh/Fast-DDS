<?xml version="1.0" encoding="UTF-8" ?>
<!-- Fast-DDS Server Minimal - Discovery Server with minimal Info-level logging and low overhead -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <log>
        <use_default>false</use_default>
        <consumer>
            <class>StdoutErrConsumer</class>
            <property>
                <name>stderr_threshold</name>
                <value>Log::Kind::Info</value>
            </property>
        </consumer>
    </log>
    
    <profiles>
        <participant profile_name="discovery_server_participant" is_default_profile="true">
            <domainId>0</domainId>
            <rtps>
                <builtin>
                    <discovery_config>
                        <discoveryProtocol>SERVER</discoveryProtocol>
                    </discovery_config>
                </builtin>
                <prefix>44.53.00.5f.45.50.52.4f.53.49.4d.41</prefix>
            </rtps>
        </participant>
    </profiles>
</dds>